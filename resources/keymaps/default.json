{
  "$schema": "forge://keymap/v1",
  "name": "Default (PhpStorm-compatible)",
  "description": "PhpStorm-compatible keymap. Key names follow Qt::KeySequence notation.",
  "license": "Apache-2.0",
  "bindings": {
    "forge.file.new":               "Ctrl+N",
    "forge.file.open":              "Ctrl+O",
    "forge.file.save":              "Ctrl+S",
    "forge.file.saveAll":           "Ctrl+Shift+S",
    "forge.file.close":             "Ctrl+F4",
    "forge.app.quit":               "Alt+F4",
    "forge.edit.undo":              "Ctrl+Z",
    "forge.edit.redo":              "Ctrl+Shift+Z",
    "forge.edit.cut":               "Ctrl+X",
    "forge.edit.copy":              "Ctrl+C",
    "forge.edit.paste":             "Ctrl+V",
    "forge.edit.selectAll":         "Ctrl+A",
    "forge.edit.duplicateLine":     "Ctrl+D",
    "forge.edit.deleteLine":        "Ctrl+Y",
    "forge.edit.toggleComment":     "Ctrl+/",
    "forge.edit.toggleBlockComment":"Ctrl+Shift+/",
    "forge.edit.moveLineUp":        "Alt+Shift+Up",
    "forge.edit.moveLineDown":      "Alt+Shift+Down",
    "forge.edit.extendSelection":   "Ctrl+W",
    "forge.edit.shrinkSelection":   "Ctrl+Shift+W",
    "forge.navigate.find":                   "Ctrl+F",
    "forge.navigate.findNext":               "F3",
    "forge.navigate.goToLine":               "Ctrl+G",
    "forge.navigate.searchEverywhere":        "Shift Shift",
    "forge.navigate.goToFile":               "Ctrl+Shift+N",
    "forge.navigate.goToClass":              "Ctrl+N",
    "forge.navigate.goToSymbol":             "Ctrl+Alt+Shift+N",
    "forge.navigate.recentFiles":            "Ctrl+E",
    "forge.navigate.recentLocations":        "Ctrl+Shift+E",
    "forge.navigate.goToDeclaration":        "Ctrl+B",
    "forge.navigate.goToImplementation":     "Ctrl+Alt+B",
    "forge.navigate.findUsages":             "Alt+F7",
    "forge.navigate.findInFiles":            "Ctrl+Shift+F",
    "forge.navigate.replaceInFiles":         "Ctrl+Shift+R",
    "forge.navigate.localFind":              "Ctrl+F",
    "forge.navigate.localReplace":           "Ctrl+R",
    "forge.code.completion":                 "Ctrl+Space",
    "forge.code.smartCompletion":            "Ctrl+Shift+Space",
    "forge.code.parameterInfo":              "Ctrl+P",
    "forge.code.quickDoc":                   "Ctrl+Q",
    "forge.code.quickDefinition":            "Ctrl+Shift+I",
    "forge.code.showIntentions":             "Alt+Enter",
    "forge.code.reformat":                   "Ctrl+Alt+L",
    "forge.code.optimizeImports":            "Ctrl+Alt+O",
    "forge.refactor.rename":                 "Shift+F6",
    "forge.refactor.extractMethod":          "Ctrl+Alt+M",
    "forge.refactor.extractVariable":        "Ctrl+Alt+V",
    "forge.refactor.extractConstant":        "Ctrl+Alt+C",
    "forge.refactor.inline":                 "Ctrl+Alt+N",
    "forge.run.run":                         "Shift+F10",
    "forge.run.debug":                       "Shift+F9",
    "forge.run.profile":                     "Alt+Shift+F10",
    "forge.run.stop":                        "Ctrl+F2",
    "forge.debug.stepOver":                  "F8",
    "forge.debug.stepInto":                  "F7",
    "forge.debug.stepOut":                   "Shift+F8",
    "forge.debug.toggleBreakpoint":          "Ctrl+F8",
    "forge.vcs.commit":                      "Ctrl+K",
    "forge.vcs.push":                        "Ctrl+Shift+K",
    "forge.vcs.update":                      "Ctrl+T",
    "forge.window.settings":                 "Ctrl+Alt+S",
    "forge.window.plugins":                  "Ctrl+Alt+Shift+P",
    "forge.window.projectTree":              "Alt+1",
    "forge.window.terminal":                 "Alt+F12",
    "forge.terminal.clear":                  "Ctrl+L",
    "forge.terminal.copy":                   "Ctrl+Shift+C",
    "forge.terminal.paste":                  "Ctrl+Shift+V"
  }
}
